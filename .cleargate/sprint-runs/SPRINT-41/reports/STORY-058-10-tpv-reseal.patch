+function claudeFileHashes(dir: string): Array<{ rel: string; sha: string }> {
+  const out: Array<{ rel: string; sha: string }> = [];
+  const walk = (abs: string, rel: string): void => {
+    for (const e of fs.readdirSync(abs, { withFileTypes: true })) {
+      const r = rel ? `${rel}/${e.name}` : e.name;
+      if (e.isDirectory()) walk(path.join(abs, e.name), r);
+      else out.push({ rel: r, sha: createHash('sha256').update(fs.readFileSync(path.join(abs, e.name))).digest('hex') });
+    }
+  };
+  if (fs.existsSync(path.join(dir, '.claude'))) walk(path.join(dir, '.claude'), '.claude');
+  for (const f of ['CLAUDE.md', '.mcp.json']) {
+    if (fs.existsSync(path.join(dir, f))) out.push({ rel: f, sha: createHash('sha256').update(fs.readFileSync(path.join(dir, f))).digest('hex') });
+  }
+  return out.sort((a, b) => a.rel.localeCompare(b.rel));
+}
