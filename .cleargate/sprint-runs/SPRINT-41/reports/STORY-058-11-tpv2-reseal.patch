+/** The measured agent_type schema value, minus the whole `<name>: {` … `}` entry of each role in `drop`. */
+function measuredAgentType(opts: { drop?: string[] } = {}): Record<string, unknown> {
+  const lines = MEASURED_AGENT_TYPE_DESCRIPTION.split('\n');
+  for (const name of opts.drop ?? []) {
+    const start = lines.indexOf(`${name}: {`);
+    assert.ok(start >= 0, `the measured layout has no ${name} entry`);
+    const end = lines.indexOf('}', start);
+    assert.ok(end > start, `the measured ${name} entry has no closing line`);
+    lines.splice(start, end - start + 1);
+  }
+  return { type: 'string', description: lines.join('\n') };
