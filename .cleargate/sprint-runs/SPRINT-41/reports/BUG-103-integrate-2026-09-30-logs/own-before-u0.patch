+        updated_at: '2026-01-01T00:00:00.000Z',
+      },
+      null,
+      2,
+    ) + '\n',
+  );
+  return stateFile;
+}
+
+function runValidateBounceReadiness(
+  repoDir: string,
+  stateFile: string,
+  storyId: string,
+): { status: number | null; stdout: string; stderr: string } {
+  const scriptPath = path.join(repoDir, '.cleargate', 'scripts', 'validate_bounce_readiness.mjs');
+  const result = spawnSync(process.execPath, [scriptPath, storyId], {
+    cwd: repoDir,
+    encoding: 'utf8',
+    env: { ...process.env, CLEARGATE_STATE_FILE: stateFile },
+  });
+  return { status: result.status, stdout: result.stdout ?? '', stderr: result.stderr ?? '' };
