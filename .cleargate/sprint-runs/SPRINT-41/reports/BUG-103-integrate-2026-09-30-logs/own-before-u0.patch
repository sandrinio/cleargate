+ *       .cleargate/wiki/** (the ingest hook rewrites the wiki on every delivery
+ *       edit; any other dirt, other .cleargate/ bookkeeping included, blocks)
+/** Compiled wiki pages, rewritten by the PostToolUse ingest hook on every delivery edit. */
+const WIKI_PREFIX = '.cleargate/wiki/';
+
+/**
+ * True when a `git status --porcelain` line only reports wiki churn. The path
+ * starts at column 3; for a rename or copy (`R  old -> new`) the new side
+ * decides, so a move out of `.cleargate/wiki/` stays dirty.
+ */
+function isWikiChurn(line) {
+  let file = line.slice(3);
+  const arrow = file.indexOf(' -> ');
+  if (arrow !== -1) file = file.slice(arrow + 4);
+  if (file.startsWith('"')) file = file.slice(1);
+  return file.startsWith(WIKI_PREFIX);
+}
+
-  if (gitOutput.trim().length > 0) {
+  // Split before any trim: the first porcelain line can start with a space
+  // (" M path"), and the path always begins at column 3.
+  const dirtyLines = gitOutput
+    .split('\n')
+    .filter((line) => line.length > 0 && !isWikiChurn(line));
+
+  if (dirtyLines.length > 0) {
-      `Error: git working tree is dirty. Uncommitted changes:\n${gitOutput}`
+      `Error: git working tree is dirty. Uncommitted changes:\n${dirtyLines.join('\n')}\n`
