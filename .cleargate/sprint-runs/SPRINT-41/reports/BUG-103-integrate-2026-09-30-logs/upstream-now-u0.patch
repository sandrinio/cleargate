+      path.join(dir, '.cleargate', 'delivery', 'pending-sync', 'SPRINT-01_Test_Sprint.md'),
+      [
+        '---',
+        'sprint_id: "SPRINT-01"',
+        'execution_mode: "v2"',
+        'updated_at: "2026-01-01T00:00:00Z"',
+        'cached_gate_result:',
+        '  pass: true',
+        '  failing_criteria: []',
+        '  last_gate_check: "2026-01-01T00:00:00Z"',
+        '  transition: "ready-for-execution"',
+        '---',
+        '',
+        '# SPRINT-01',
+        '',
+        '## 1. Consolidated Deliverables',
+        '',
+        '- EPIC-047-02',
+        '',
+      ].join('\n'),
+    );
+
+    commitAll(dir, 'fixture: T2 stamped-then-re-gated item');
+
+    // Step 0's gate check must not disturb the state already established
+    // above — this test is about Check 5's read, not about Step 0's write.
+    const execFn = (cmd: string, opts: { cwd: string; encoding: 'utf8' }): string => {
