+      throw new CodexConfigError(
+        `${file}: ${SANDBOX_TABLE} is defined by an inline table, dotted keys, a sub-table, or an array-of-tables; remove ${root} from its ${WRITABLE_ROOTS_KEY} by hand`,
+        file,
+      );
+    }
+    return { next: existing, removed: false };
+  }
+  if (!table) {
+    return { next: existing, removed: false };
+  }
+
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const kv = (table.body as any[]).find(
+    (node) => node.key.keys.length === 1 && keyName(node.key.keys[0]) === WRITABLE_ROOTS_KEY,
+  );
+  if (!kv || kv.value.type !== 'TOMLArray') {
+    return { next: existing, removed: false };
+  }
+
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const elements: any[] = kv.value.elements;
+  const kept = elements.filter((el) => !(el.type === 'TOMLValue' && el.kind === 'string' && el.value === root));
+  if (kept.length === elements.length) {
+    return { next: existing, removed: false };
+  }
+
+  let next: string;
+  if (kept.length > 0) {
+    const text = `[${kept.map((el) => existing.slice(el.range[0], el.range[1])).join(', ')}]`;
+    next = existing.slice(0, kv.value.range[0]) + text + existing.slice(kv.value.range[1]);
+  } else if ((table.body as unknown[]).length > 1) {
+    const start = lineStartBefore(existing, kv.range[0]);
+    const end = afterNewline(existing, lineTailEnd(existing, kv.range[1]));
+    next = existing.slice(0, start) + existing.slice(end);
+  } else {
+    const start = lineStartBefore(existing, table.range[0]);
+    let end = lineTailEnd(existing, table.range[1]);
+    for (let i = 0; i < 2; i++) end = afterNewline(existing, end);
+    next = existing.slice(0, start) + existing.slice(end);
+  }
+
+  parseOrThrow(next, file);
+  return { next, removed: true };
+}
