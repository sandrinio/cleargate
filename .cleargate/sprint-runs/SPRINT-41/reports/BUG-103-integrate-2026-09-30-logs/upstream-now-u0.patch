+/**
+ * BUG-047: the single freshness rule for a cached gate result.
+ *
+ * A cache is fresh when it has a `last_gate_check` and that stamp is at or
+ * after the item's `updated_at` (lexical compare of ISO-second strings). The
+ * boundary is inclusive: the stamp-and-gate hook writes both fields in the
+ * same second, and that item is fresh. An absent `updated_at` counts as fresh.
+ * The verdict (`pass`) plays no part in freshness.
+ *
+ * Used by writeCachedGate's idempotency skip, by `sprint preflight` Check 5
+ * (items and the sprint plan) and by the Step 0 restore guard.
+ */
+export function isGateCacheFresh(
+  cached: { last_gate_check: string } | null,
+  updatedAt: string
+): boolean {
+  return (
+    cached !== null &&
+    cached.last_gate_check !== '' &&
+    (updatedAt === '' || cached.last_gate_check >= updatedAt)
+  );
+}
