+// ─── T5 (CR-038 + BUG-047): Step 0 restore guard — keep a stale advance, restore a fresh one
+
+function buildSingleItemStep0Fixture(
+  dir: string,
+  sprintId: string,
+  item: { id: string; pass: boolean; lastGateCheck: string; updatedAt: string },
+): { itemPath: string; before: string } {
+  writeFile(path.join(dir, 'README.md'), '# fixture\n');
+  writeFile(
+    path.join(dir, '.cleargate', 'delivery', 'pending-sync', `${sprintId}_Test_Sprint.md`),
+    [
+      '---',
+      `sprint_id: "${sprintId}"`,
+      'execution_mode: "v2"',
+      'updated_at: "2026-01-01T00:00:00Z"',
+      'cached_gate_result:',
+      '  pass: true',
+      '  failing_criteria: []',
+      '  last_gate_check: "2026-06-01T00:00:00Z"',
+      '---',
+      '',
+      `# ${sprintId}`,
+      '',
+      '## 1. Consolidated Deliverables',
+      '',
+      `- ${item.id}`,
+      '',
+    ].join('\n'),
+  );
+  const itemPath = path.join(dir, '.cleargate', 'delivery', 'pending-sync', `${item.id}_Test_Item.md`);
+  writeFile(
+    itemPath,
+    [
+      '---',
+      'status: "Ready"',
+      `updated_at: "${item.updatedAt}"`,
+      'cached_gate_result:',
+      `  pass: ${item.pass}`,
+      '  failing_criteria: []',
+      `  last_gate_check: "${item.lastGateCheck}"`,
+      '---',
+      '',
+      `# ${item.id}`,
+      '',
+      '## 1. Summary',
+      '- test item',
+      '',
+    ].join('\n'),
+  );
+  commitAll(dir, `fixture: T5 step0 ${sprintId} ${item.id}`);
+  const before = fs.readFileSync(itemPath, 'utf8');
+  return { itemPath, before };
+}
+
+/**
+ * execFn whose `gate check` branch mimics a real `writeCachedGate` write
+ * that reaffirms the SAME verdict but stamps a fresh `last_gate_check` —
+ * the exact shape a real gate check produces (Scenario 20's 'stamp'
+ * behaviour in sprint-preflight.node.test.ts).
+ */
+function makeStampMockExecFn(itemId: string, itemPath: string): (cmd: string, opts: { cwd: string; encoding: 'utf8' }) => string {
+  return (cmd, opts) => {
+    if (cmd.includes('--emit-json')) return JSON.stringify({ workItemIds: [itemId] });
+    if (cmd.includes('gate check')) {
+      let body = fs.readFileSync(itemPath, 'utf8');
+      body = body.replace(/^(\s*last_gate_check:).*$/m, '$1 "2026-12-31T23:59:59Z"');
+      fs.writeFileSync(itemPath, body, 'utf8');
+      return '';
+    }
+    return execSync(cmd, { ...opts, stdio: 'pipe' }) as unknown as string;
+  };
+}
+
+describe('T5 (CR-038 + BUG-047): Step 0 restore guard — keep a stale advance, restore a fresh one', () => {
+  test('a stale item keeps its Step-0 stamp advance; an already-fresh item is still restored', () => {
+    // Case A — STALE before Step 0 (last_gate_check < updated_at): a
+    // same-verdict gate check that stamps a fresh last_gate_check must
+    // SURVIVE restoreIfOnlyTimestampMoved — that survival is the whole
+    // point of the fix. Today the guard is unconditional and reverts it,
+    // re-creating the BUG-047 deadlock.
+    const staleDir = makeTmpDir('cg-gcs-t5a-');
+    initGitRepo(staleDir);
+    const { itemPath: staleItemPath, before: staleBefore } = buildSingleItemStep0Fixture(staleDir, 'SPRINT-01', {
+      id: 'EPIC-047-05',
+      pass: true,
+      lastGateCheck: '2026-01-01T00:00:00Z',
+      updatedAt: '2026-05-01T00:00:00Z',
+    });
+    const cap1 = makeCapture();
+    runPreflight('SPRINT-01', staleDir, cap1, makeStampMockExecFn('EPIC-047-05', staleItemPath));
+    assert.notStrictEqual(
+      fs.readFileSync(staleItemPath, 'utf8'),
+      staleBefore,
+      'BUG-047: a stale item’s Step-0 stamp advance must survive the restore guard',
+    );
+    assert.strictEqual(
+      (readFm(staleItemPath)['cached_gate_result'] as { last_gate_check: string }).last_gate_check,
+      '2026-12-31T23:59:59Z',
+      'BUG-047: the surviving bytes carry the Step-0 stamp',
+    );
+
+    // Case B — already FRESH before Step 0: the SAME timestamp-only
+    // rewrite must still be reverted (CR-038 anti-thrash, unchanged by
+    // the fix).
+    const freshDir = makeTmpDir('cg-gcs-t5b-');
+    initGitRepo(freshDir);
+    const { itemPath: freshItemPath, before: freshBefore } = buildSingleItemStep0Fixture(freshDir, 'SPRINT-01', {
+      id: 'EPIC-047-06',
+      pass: true,
+      lastGateCheck: '2026-06-01T00:00:00Z',
+      updatedAt: '2026-01-01T00:00:00Z',
+    });
+    const cap2 = makeCapture();
+    runPreflight('SPRINT-01', freshDir, cap2, makeStampMockExecFn('EPIC-047-06', freshItemPath));
+    assert.strictEqual(
+      fs.readFileSync(freshItemPath, 'utf8'),
+      freshBefore,
+      'CR-038: an already-fresh item’s timestamp-only rewrite must still be reverted',
+    );
+
+    // Case C — FRESH exactly at the boundary (last_gate_check == updated_at,
+    // fresh per M7 §3's >=): still restored.
+    const edgeDir = makeTmpDir('cg-gcs-t5c-');
+    initGitRepo(edgeDir);
+    const { itemPath: edgeItemPath, before: edgeBefore } = buildSingleItemStep0Fixture(edgeDir, 'SPRINT-01', {
+      id: 'EPIC-047-07',
+      pass: true,
+      lastGateCheck: '2026-05-01T00:00:00Z',
+      updatedAt: '2026-05-01T00:00:00Z',
+    });
+    const cap3 = makeCapture();
+    runPreflight('SPRINT-01', edgeDir, cap3, makeStampMockExecFn('EPIC-047-07', edgeItemPath));
+    assert.strictEqual(
+      fs.readFileSync(edgeItemPath, 'utf8'),
+      edgeBefore,
+      'CR-038: a boundary-fresh item (last_gate_check == updated_at) must still be restored',
+    );
+
+    // Case D — STALE and FAILING: M7 §3's rule reads freshness only, not pass,
+    // so the Step-0 stamp survives here too.
+    const failDir = makeTmpDir('cg-gcs-t5d-');
+    initGitRepo(failDir);
+    const { itemPath: failItemPath } = buildSingleItemStep0Fixture(failDir, 'SPRINT-01', {
+      id: 'EPIC-047-08',
+      pass: false,
+      lastGateCheck: '2026-01-01T00:00:00Z',
+      updatedAt: '2026-05-01T00:00:00Z',
+    });
+    const cap4 = makeCapture();
+    runPreflight('SPRINT-01', failDir, cap4, makeStampMockExecFn('EPIC-047-08', failItemPath));
+    assert.strictEqual(
+      (readFm(failItemPath)['cached_gate_result'] as { last_gate_check: string }).last_gate_check,
+      '2026-12-31T23:59:59Z',
+      'BUG-047: a stale failing item keeps its Step-0 stamp too',
+    );
+  });
+});
