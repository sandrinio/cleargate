# ⚠ THIS FILE DOES NOT SHIP. Do not edit it expecting a user to receive the change.
#
# npm-packlist strips any file named `.gitignore` from a published tarball,
# unconditionally, so this file has never existed in a released artifact
# (CR-090). CR-072 expanded it anyway and closed Completed; BUG-040 is that
# discovery. `cleargate init` now GENERATES the root ignore instead — the
# content a user actually receives lives in
# `cleargate-cli/src/init/root-gitignore.ts`. Change it there.
#
# This copy is kept only as the meta-repo's own reference for the intended
# full pattern set.

# ── Secrets ─────────────────────────────────────────────────────────────────
# Local environment files (API keys, tokens, credentials)
# The allowlist lines below MUST come AFTER .env* so the negation overrides.
.env
.env.*
!.env.example
!.env.template

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/

# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# ── ClearGate per-participant ─────────────────────────────────────────────────
# Per-participant identity file — personal email, not team-shared
/.cleargate/.participant.json

# Sync drift marker — per-machine runtime state, not team-shared
/.cleargate/.sync-marker.json

# Comment snapshot cache — runtime-generated, not team-shared
/.cleargate/.comments-cache/

# Unresolved conflicts cache — runtime-generated, not team-shared
/.cleargate/.conflicts.json

# CR-084: regenerated sprint-dashboard snapshot — per-machine, not team-shared
.cleargate/sprint-runs/*/dashboard.html

# ── ClearGate worktrees ───────────────────────────────────────────────────────
# Story worktrees — ephemeral per-story git worktrees (v2 execution)
.worktrees/

# ── ClearGate telemetry ───────────────────────────────────────────────────────
# Hook execution logs — runtime-generated, per-machine, not team-shared
/.cleargate/hook-log/
