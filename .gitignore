# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# Claude Code local config (root-only — runtime instance is not team-shared;
# canonical definitions live in cleargate-planning/.claude/ and ARE tracked)
/.claude/

# Private project notes (design guides, reference docs) — not shipped
/knowledge/

# Working notes / brainstorm drafts — local-only, not team-shared
/.cleargate/scratch/

# Active-sprint sentinel — per-machine runtime state, not team-shared
.cleargate/sprint-runs/.active

# Canonical scaffold ships an EMPTY skeleton — runtime sprint-runs ledger/state
# must never land under it. A misrouted token-ledger write (wrong root) created
# cleargate-planning/.cleargate/sprint-runs/_off-sprint/ on 2026-06-02; guard against recurrence.
cleargate-planning/.cleargate/sprint-runs/

# Hook execution log — per-machine runtime, dirties git status on every session
/.cleargate/hook-log/

# Per-participant identity file — personal email, not team-shared
/.cleargate/.participant.json

# Per-machine join state (project_id + joined_at) — written by `cleargate join`, not team-shared
/.cleargate/.join.json

# Sync drift marker — per-machine runtime state, not team-shared
# (anchored at any depth — also catches cleargate-cli/.cleargate/.sync-marker.json)
**/.cleargate/.sync-marker.json

# Comment snapshot cache — runtime-generated, not team-shared
/.cleargate/.comments-cache/

# Live-smoke harness output — PNG screenshots + JSON summaries per run,
# ephemeral debugging artefacts, not source.
/admin/scripts/smoke-output/

# Story worktrees — ephemeral per-story git worktrees (v2 execution)
.worktrees/

# Deploy products — each its own nested git repo, never tracked by this
# planning repo. Split out of the monorepo 2026-05-31; re-cloned side-by-side
# so cleargate-cli's prebuild still finds ../cleargate-planning.
#   mcp/           → sandrinio/cleargate-mcp        (Coolify)
#   cleargate-cli/ → sandrinio/cleargate-cli        (npm publish)
#   admin/         → sandrinio/cleargate-admin      (Coolify)
#   connector/     → sandrinio/cleargate-connector  (broker+daemon; INITIATIVE-001)
/mcp/
/cleargate-cli/
/admin/
/connector/

# Node — per-package .gitignore files handle node_modules/dist/.env
# but belt-and-suspenders at root:
node_modules/

# Transient pre-gate scan output (pre_gate_runner.sh) — regenerated per scan
.cleargate/reports/

# Transient run_script.sh incident captures — diagnostic, regenerated on failure
.cleargate/sprint-runs/**/.script-incidents/
.cleargate/sprint-runs/_off-sprint/.script-incidents/

# Ephemeral dispatch markers (write_dispatch.sh / pre-tool-use-task.sh) — consumed by hook
.cleargate/sprint-runs/**/.dispatch-*.json
.cleargate/sprint-runs/_off-sprint/.dispatch-*.json
